{
	"name": "usub",
	"description": "Subscribe to any reactive sources",
	"version": "0.12.0",
	"type": "module",
	"source": "./src/index.js",
	"types": "./types/index.d.ts",
	"main": "./dist/index.cjs",
	"module": "./dist/index.es.js",
	"unpkg": "./dist/index.min.js",
	"umd:main": "./dist/index.umd.js",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"browser": "./dist/index.es.js",
			"umd": "./dist/index.umd.js",
			"require": "./dist/index.cjs",
			"import": "./dist/index.es.js",
			"default": "./dist/index.es.js"
		},
		"./lite": {
			"types": "./types/lite.d.ts",
			"browser": "./lite/dist/index.es.js",
			"umd": "./lite/dist/index.umd.js",
			"require": "./lite/dist/index.cjs",
			"import": "./lite/dist/index.es.js",
			"default": "./lite/dist/index.es.js"
		},
		"./tiny": {
			"types": "./types/tiny.d.ts",
			"browser": "./tiny/dist/index.es.js",
			"umd": "./tiny/dist/index.umd.js",
			"require": "./tiny/dist/index.cjs",
			"import": "./tiny/dist/index.es.js",
			"default": "./tiny/dist/index.es.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kethan/usub.git"
	},
	"files": [
		"dist",
		"lite",
		"tiny",
		"src",
		"types"
	],
	"scripts": {
		"build": "node -e \"import('node:fs').then(f=>['dist','lite/dist','tiny/dist'].forEach(d=>f.rmSync(d,{recursive:true,force:true})))\" && rollup --config rollup.config.js",
		"test": "npm run build && npm run typecheck && vitest --run",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.nodenext.json",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@maverick-js/signals": "^6.0.0",
		"@preact/signals-core": "^1.14.4",
		"@reactively/core": "^0.0.8",
		"@rescript/runtime": "^12.3.1",
		"@rollup/plugin-terser": "^1.0.0",
		"@tanstack/store": "^0.11.2",
		"@vitest/coverage-v8": "^5.0.5",
		"@volynets/reflex": "^3.0.2",
		"@volynets/reflex-runtime": "^1.2.0",
		"@vue/reactivity": "^3.5.44",
		"@webreflection/alien-signals": "^0.4.2",
		"@webreflection/signal": "^2.1.2",
		"@webreflection/signals": "^0.2.8",
		"@zakkster/lite-signal": "^1.5.2",
		"alien-signals": "^3.2.1",
		"anod": "^0.9.1",
		"mobx": "^7.1.1",
		"nanostores": "^1.5.5",
		"observ": "^0.2.0",
		"observable": "^2.1.4",
		"oby": "^15.1.2",
		"rescript-signals": "^3.2.0",
		"rollup": "^4.20.0",
		"rollup-plugin-bundle-size": "^1.0.3",
		"rxjs": "^7.8.2",
		"s-js": "^0.4.9",
		"sinuous": "^0.32.1",
		"solid-js": "^1.9.17",
		"typescript": "^7.0.2",
		"ulive": "^1.0.7",
		"usignal": "^0.10.0",
		"vitest": "^5.0.5",
		"vue-reactivity-3.6": "npm:@vue/reactivity@^3.6.0-rc.12"
	},
	"keywords": [
		"rxjs",
		"usub",
		"reactive",
		"state",
		"signal",
		"async",
		"observable",
		"observables",
		"subscribe",
		"effect",
		"react",
		"preact",
		"solidjs"
	],
	"author": "Kethan Surana",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/kethan/usub/issues"
	},
	"homepage": "https://github.com/kethan/usub#readme"
}
