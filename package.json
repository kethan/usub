{
	"name": "usub",
	"description": "Subscribe to any reactive sources",
	"version": "0.9.0",
	"type": "module",
	"source": "./src/index.js",
	"main": "./dist/index.cjs",
	"module": "./dist/index.es.js",
	"unpkg": "./dist/index.min.js",
	"umd:main": "./dist/index.umd.js",
	"exports": {
		".": {
			"browser": "./dist/index.es.js",
			"umd": "./dist/index.umd.js",
			"require": "./dist/index.cjs",
			"import": "./dist/index.es.js",
			"default": "./dist/index.es.js"
		},
		"./lite": {
			"browser": "./lite/dist/index.es.js",
			"umd": "./lite/dist/index.umd.js",
			"require": "./lite/dist/index.cjs",
			"import": "./lite/dist/index.es.js",
			"default": "./lite/dist/index.es.js"
		},
		"./tiny": {
			"browser": "./tiny/dist/index.es.js",
			"umd": "./tiny/dist/index.umd.js",
			"require": "./tiny/dist/index.cjs",
			"import": "./tiny/dist/index.es.js",
			"default": "./tiny/dist/index.es.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kethan/usub.git"
	},
	"files": [
		"dist",
		"lite",
		"tiny",
		"src"
	],
	"scripts": {
		"build": "rollup --config rollup.config.js",
		"test": "node --allow-natives-syntax --expose-gc ./test/index.js",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include='lite/**' --test-coverage-include='tiny/**' --test-coverage-exclude='**/dist/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --allow-natives-syntax --expose-gc ./test/index.js"
	},
	"devDependencies": {
		"@preact/signals-core": "^1.14.4",
		"@rollup/plugin-terser": "^1.0.0",
		"@webreflection/signal": "^2.1.2",
		"observ": "^0.2.0",
		"observable": "^2.1.4",
		"rollup": "^4.20.0",
		"rollup-plugin-bundle-size": "^1.0.3",
		"rxjs": "^7.8.2",
		"solid-js": "^1.9.17",
		"tst": "^7.3.0",
		"ulive": "^1.0.7",
		"usignal": "^0.10.0"
	},
	"keywords": [
		"rxjs",
		"usub",
		"reactive",
		"state",
		"signal",
		"async",
		"observable",
		"observables",
		"subscribe",
		"effect",
		"react",
		"preact",
		"solidjs"
	],
	"author": "Kethan Surana",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/kethan/usub/issues"
	},
	"homepage": "https://github.com/kethan/usub#readme"
}
